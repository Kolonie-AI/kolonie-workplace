# Kolonie Workplace — live configuration.
#
# Copy to `.env.local` and fill in every value to use the live Colony. This file
# deliberately holds no values. With every variable absent, local development
# uses fixture data; a partial live configuration is refused.
#
# The workplace is a public PKCE client. It has no client secret.

VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_CALLBACK=
VITE_AUTH0_AUDIENCE=
VITE_PLATFORM_API_ORIGIN=
