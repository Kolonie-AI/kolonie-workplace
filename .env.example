# Kolonie Workplace — Auth0 configuration.
#
# Copy to `.env.local` and fill in the values for your tenant. This file names
# the variables and deliberately holds no values: the tenant host name, the
# client id and the callback URL are deployment configuration and are never
# committed (see AGENTS.md §3 and issue #2).
#
# Real values come from the maintainer-owned environment file on the build
# host. Ask the maintainer rather than reading them out of a running service.
#
# The workplace is a public PKCE client, so there is no client secret — not
# here, not on the tenant, not anywhere. If you are looking for one, something
# has been misconfigured.
#
# The workplace never falls back to the fixture picker. With any value missing,
# it refuses to start in every build mode.

# The Auth0 tenant, host name only, no scheme and no path.
VITE_AUTH0_DOMAIN=

# The workplace application's client id. Public, but still tenant configuration.
VITE_AUTH0_CLIENT_ID=

# The callback registered for this origin, ending /sign-in/callback.
# It must exactly match a callback URL registered on the tenant, or Auth0
# answers 403 "Callback URL mismatch".
VITE_AUTH0_CALLBACK=
